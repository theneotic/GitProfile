# --- GitHub OAuth App (create at https://github.com/settings/developers) ---
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback

# --- GitHub API access for server-to-server fallback/higher rate limits (optional, a PAT with no scopes for public-data-only reads) ---
GITHUB_FALLBACK_TOKEN=

# --- Session / JWT ---
JWT_ACCESS_SECRET=your_32_byte_access_secret_openssl_rand_hex_32
JWT_REFRESH_SECRET=your_32_byte_refresh_secret_openssl_rand_hex_32
OAUTH_STATE_SECRET=your_32_byte_oauth_state_hmac_secret_openssl_rand_hex_32

# --- Supabase (create a project at https://supabase.com) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_secret
SUPABASE_ANON_KEY=your_supabase_anon_public_key
PGCRYPTO_ENCRYPTION_KEY=your_32_byte_pgcrypto_encryption_key_hex

# --- Upstash Redis (create a database at https://upstash.com) ---
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# --- App config ---
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
